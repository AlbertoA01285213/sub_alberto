<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="uuv_world">

    <gravity>0 0 0</gravity>
    
    <physics name="1ms" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/sun</uri>
    </include>

    <model name="water_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0 0.5 1 0.5</ambient>
            <diffuse>0 0.5 1 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine> </plugin>

    <gui fullscreen='0'>
      <plugin filename="ImageDisplay" name="Image Display">
        <ignition-gui>
          <property key="state" type="string">floating</property> <property key="width" type="double">400</property>  <property key="height" type="double">300</property>
          <property key="x" type="double">0</property>       <property key="y" type="double">0</property>
          <property key="showTitleBar" type="bool">true</property>
        </ignition-gui>
        <topic>camera/left</topic>
      </plugin>

      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property key="state" type="string">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">500</property>
          <property key="width" type="double">400</property>
          <property key="height" type="double">100</property>
        </ignition-gui>
      </plugin>
    </gui>
  </world>
</sdf>