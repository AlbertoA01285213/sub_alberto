    <model name="water_volume">
      <static>true</static>
      <pose>0 0 -5 0 0 0</pose> <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>100 100 10</size> </box>
          </geometry>
          <material>
            <ambient>0 0.5 0.5 0.3</ambient> 
            <diffuse>0 0.5 0.8 0.3</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <scene>
      <ambient>0.2 0.2 0.2 0.3</ambient>
      <background>0 0.1 0.2 0.3</background> <shadows>true</shadows>
      <fog>
        <color>0 0.2 0.4 0.3</color>
        <type>linear</type>
        <start>0.1</start>
        <end>30</end> </fog>
    </scene>

    <model name="mesa">
      <static>true</static>
      <link name="link">
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///uuv_description/models/ocean_cleanup_table/meshes/mesa.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>file:///uuv_description/models/ocean_cleanup_table/meshes/mesa.obj</uri>
            </mesh>
          </geometry>
        </visual>
        <pose>0 0 0 0 0 0 </pose>
        <inertial>
          <pose>0 0 0 0 0 0 </pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
      </link>
      <pose>21 4 -2 1.57 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name="octagon">
      <static>true</static>
      <link name="link">
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///uuv_description/models/ocean_cleanup_octagon/meshes/octagon.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>file:///uuv_description/models/ocean_cleanup_octagon/meshes/octagon.obj</uri>
            </mesh>
          </geometry>
        </visual>
        <pose>0 0 0 0 0 0 </pose>
        <inertial>
          <pose>0 0 0 0 0 0 </pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
      </link>
      <pose>21 4 0 1.57 0 0</pose>
      <self_collide>false</self_collide>
    </model>

